{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Organize, search, sort and annotate the servers in your multiplayer server list.",
  "authors": [
    "PrexorJustin"
  ],
  "contact": {
    "sources": "https://github.com/PrexorJustin/ServerListPlus",
    "issues": "https://github.com/PrexorJustin/ServerListPlus/issues"
  },
  "license": "MIT",
  "icon": "assets/serverlistplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.prexorjustin.serverlistplus.platform.ServerListPlusFabric"
    ]
  },
  "mixins": [
    "serverlistplus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
